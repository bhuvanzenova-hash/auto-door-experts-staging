dth": {"unit": "px", "top": "1", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "border_color": "rgba(255,255,255,0.08)", "margin": {"unit": "px", "top": "64", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_direction_mobile": "column"}, "elements": [{"id": "06a8018", "elType": "widget", "settings": {"editor": "<p>© 2026 The Auto Door Experts</p>", "text_color": "#A9AFB8", "_css_classes": "ade-txt", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 13.5, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.65, "sizes": []}}, "elements": [], "widgetType": "text-editor"}, {"id": "d9a3690", "elType": "widget", "settings": {"editor": "<p><a href=\"/privacy-policy/\">Privacy</a> · <a href=\"/terms-conditions/\">Terms</a> · Not associated with ADIS.</p>", "text_color": "#A9AFB8", "_css_classes": "ade-txt ade-footlinks", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 13.5, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.65, "sizes": []}}, "elements": [], "widgetType": "text-editor"}], "isInner": true}, {"id": "8e26511", "elType": "widget", "settings": {"html": "<div class=\"ade-actionbar\"><a href=\"tel:1300829998\">Call 24/7</a><a href=\"/contact-us/#quote\">Get a free quote</a></div>\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n  // Quote form: preselect a service from ?service= or from the page, and nudge emergencies to call.\n  var pagePreset = { \"emergency-breakdown-service\": \"Emergency repair\", \"sales-and-installation\": \"New door\", \"periodic-maintenance\": \"Maintenance\", \"spare-parts\": \"Spare parts\" };\n  var slug = location.pathname.split(\"/\").filter(Boolean).pop();\n  var wanted = new URLSearchParams(location.search).get(\"service\") || pagePreset[slug];\n  document.querySelectorAll(\".ade-form\").forEach(function (form) {\n    var radios = form.querySelectorAll('input[name=\"service\"]');\n    var alertBox = form.querySelector(\".ade-alert\");\n    var sync = function () {\n      var picked = form.querySelector('input[name=\"service\"]:checked');\n      if (alertBox) alertBox.hidden = !(picked && radios[0] === picked);\n    };\n    radios.forEach(function (r) {\n      var text = r.parentElement.querySelector(\".wpcf7-list-item-label\").textContent.trim();\n      if (wanted && text === wanted) r.checked = true;\n      r.addEventListener(\"change\", sync);\n    });\n    sync();\n  });\n\n  // Blog article: build \"On this page\" from the h2s and show a reading-progress bar.\n  var prose = document.querySelector(\".ade-prose\");\n  if (prose) {\n    var toc = document.querySelector(\".ade-toc\");\n    var heads = prose.querySelectorAll(\"h2\");\n    if (toc && heads.length > 2) {\n      var list = document.createElement(\"ol\");\n      heads.forEach(function (h, i) {\n        h.id = h.id || \"section-\" + (i + 1);\n        var li = document.createElement(\"li\"), a = document.createElement(\"a\");\n        a.href = \"#\" + h.id; a.textContent = h.textContent;\n        li.appendChild(a); list.appendChild(li);\n      });\n      toc.innerHTML = \"<p>On this page</p>\";\n      toc.appendChild(list);\n    }\n    var bar = document.createElement(\"div\");\n    bar.className = \"ade-progress\";\n    document.body.appendChild(bar);\n    addEventListener(\"scroll\", function () {\n      var r = prose.getBoundingClientRect();\n      bar.style.transform = \"scaleX(\" + Math.min(1, Math.max(0, -r.top / (r.height - innerHeight * 0.6))) + \")\";\n    }, { passive: true });\n  }\n});\n</script>\n", "_css_classes": "ade-snippet"}, "elements": [], "widgetType": "html"}], "isInner": false}], "page_settings": [], "version": "0.4", "title": "ADE Footer", "type": "section"}